# 复制为 .env.local 后填写。VITE_ 变量会进入浏览器，请使用受限的只读令牌。
# 修改 .env.local 后重启 Vite 开发服务器；不要将令牌提交到 Git。

# Cesium ion 公共访问令牌；申请并限制来源和可访问资源。
VITE_CESIUM_ION_TOKEN=
# true 时尝试加载 Cesium World Terrain；默认 false。
VITE_CESIUM_TERRAIN=false

# 二选一：有授权的上海实景 3D Tiles 服务 URL 或 Cesium ion 资源 ID。
# URL 优先；地址须为 tileset.json，服务需允许跨域，且授权允许本项目使用。
VITE_CESIUM_3DTILES_URL=
VITE_CESIUM_3DTILES_ION_ASSET_ID=

# 可选：一个有授权的 glTF/GLB PBR 地标模型与 WGS84 坐标。
# 高度单位为米，朝向单位为度；跨域资源需允许浏览器访问。
VITE_LANDMARK_URL=
VITE_LANDMARK_LONGITUDE=
VITE_LANDMARK_LATITUDE=
VITE_LANDMARK_HEIGHT=0
VITE_LANDMARK_HEADING=0
